  gatewayReference  String?  @map("gateway_reference") @db.VarChar(200)
  status            String   @default("completed") @db.VarChar(20) // completed | pending | failed | reversed
  flagged           Boolean  @default(false)
  flagReason        String?  @map("flag_reason") @db.Text
  ipAddress         String?  @map("ip_address") @db.VarChar(50)
  deviceFingerprint String?  @map("device_fingerprint") @db.VarChar(200)
  createdAt         DateTime @default(now()) @map("created_at")

  wallet PayWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt], map: "idx_kv_pay_transactions_wallet_time")
  @@index([transactionType], map: "idx_kv_pay_transactions_type")
