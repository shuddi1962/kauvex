// ============================================================
// SECTION 1.5: KAUVEX ADS PLATFORM
// ============================================================

model AdCampaign {
  id              String        @id @default(cuid())
  vendorId        String
  name            String
  type            String
  status          String        @default("draft")
  budget          Decimal       @db.Decimal(12, 2)
  budgetType      String        @default("daily")
  bidAmount       Decimal       @db.Decimal(10, 2)
