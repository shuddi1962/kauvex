  targetCategories String[]
  targetStorefronts String[]
  startDate       DateTime
  endDate         DateTime?
  totalSpent      Decimal       @default(0) @db.Decimal(12, 2)
  totalImpressions Int          @default(0)
  totalClicks     Int           @default(0)
  totalConversions Int          @default(0)
