// SECTION 1.15: API KEYS & EXTERNAL ACCESS
// ============================================================

model ApiKey {
  id            String       @id @default(cuid())
  name          String
  keyHash       String       @unique
  keyPrefix     String
  ownerId       String
  ownerType     String
  scopes        String[]
  rateLimitPerMin Int        @default(60)
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  requests      ApiRequest[]

  @@map("api_keys")
}

model ApiRequest {
  id            String   @id @default(cuid())
  apiKeyId      String
  endpoint      String
  method        String
  statusCode    Int
  responseTime  Int
  ipAddress     String?
  createdAt     DateTime @default(now())

  apiKey        ApiKey   @relation(fields: [apiKeyId], references: [id])

  @@index([apiKeyId, createdAt])
  @@map("api_requests")
}

model Webhook {
  id            String          @id @default(cuid())
