# ============================================================
# KAUVEX — Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# Supabase Backend (BaaS)
NEXT_PUBLIC_SUPABASE_URL=https://stbgamqenraauqpgtbkv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=KAUVEX

# Geo & Currency API (free tiers, no key required)
NEXT_PUBLIC_GEO_API_URL=https://ipapi.co
NEXT_PUBLIC_EXCHANGE_RATE_API=https://open.er-api.com/v6/latest/NGN

# ============================================================
# OPTIONAL — Add these when you have the API keys
# ============================================================

# Payment Gateways
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxx
# PAYSTACK_SECRET_KEY=sk_live_xxx
# NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxx
# FLUTTERWAVE_SECRET_KEY=FLWSECK-xxx

# Google Services
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXX
# GOOGLE_MAPS_API_KEY=AIzaSyXXXX
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com

# Email / SMS
# SENDGRID_API_KEY=SG.xxxx
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Business
# NEXT_PUBLIC_WHATSAPP_NUMBER=2348012345678

# Cloudinary (Image hosting)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=xxx
# CLOUDINARY_API_SECRET=xxx

# OpenAI (for AI features)
# OPENAI_API_KEY=sk-xxx

# ============================================================
# PHASE 25 — Security & External Services
# ============================================================

# Sentry Error Monitoring
# SENTRY_DSN=https://xxx@sentry.io/xxxxx

# File Scanning (VirusTotal + Sightengine)
# VIRUSTOTAL_API_KEY=your_virustotal_api_key
# SIGHTENGINE_API_USER=your_sightengine_user
# SIGHTENGINE_API_KEY=your_sightengine_key

# Identity Verification / KYC
# SMILE_IDENTITY_API_KEY=your_smile_identity_key
# SMILE_IDENTITY_PARTNER_ID=your_smile_identity_partner_id
# ONFIDO_API_TOKEN=your_onfido_api_token

# Cloudflare R2 (Backups)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=your_r2_bucket_name

# OpenRouter (AI Quote Draft — already in use)
# OPENROUTER_API_KEY=your_openrouter_key
