model KaiConversation {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  sessionId    String   @map("session_id") @db.VarChar(100)
  persona      String   @default("sarah") @db.VarChar(50)
  context      Json?    @default("{}")
  metadata     Json?    @default("{}")
  messageCount Int      @default(0) @map("message_count")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  messages KaiMessage[]

  @@index([userId], map: "idx_kai_conv_user")
  @@index([sessionId], map: "idx_kai_conv_session")
  @@index([isActive], map: "idx_kai_conv_active")
  @@map("kv_kai_conversations")
}

model KaiMessage {
  id               String   @id @default(uuid()) @db.Uuid
  conversationId   String   @map("conversation_id") @db.Uuid
  role             String   @db.VarChar(10)
  content          String   @db.Text
  sources          Json?    @map("sources")
  tokensUsed       Int      @default(0) @map("tokens_used")
  latencyMs        Int      @default(0) @map("latency_ms")
  metadata         Json?    @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")

  conversation KaiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
