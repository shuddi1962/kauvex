model PayTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  walletId          String   @map("wallet_id") @db.Uuid
  transactionType   String   @map("transaction_type") @db.VarChar(30) // top_up | purchase | refund | cashback | withdrawal | transfer | bnpl_charge | fee_deduction | ad_spend | fbk_fee | loyalty_conversion | late_fee
  amount            Decimal  @db.Decimal(14, 2)
  direction         String   @db.VarChar(10) // credit | debit
  balanceBefore     Decimal  @map("balance_before") @db.Decimal(14, 2)
  balanceAfter      Decimal  @map("balance_after") @db.Decimal(14, 2)
  referenceType     String?  @map("reference_type") @db.VarChar(30) // order | bnpl_payment | payout | manual
  referenceId       String?  @map("reference_id") @db.Uuid
