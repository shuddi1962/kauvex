  reservedBalance        Decimal  @default(0) @map("reserved_balance") @db.Decimal(14, 2)
  currency               String   @default("NGN") @db.VarChar(10)
  status                 String   @default("active") @db.VarChar(20) // active | frozen | restricted | closed
