model KaiKnowledgeChunk {
  id          String   @id @default(uuid()) @db.Uuid
  category    String   @db.VarChar(50)
  subcategory String?  @db.VarChar(100)
  title       String   @db.VarChar(500)
  content     String   @db.Text
  metadata    Json?    @default("{}")
  sourceUrl   String?  @map("source_url") @db.Text
  language    String   @default("en") @db.VarChar(10)
  chunkIndex  Int      @default(0) @map("chunk_index")
  parentId    String?  @map("parent_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  parent    KaiKnowledgeChunk?  @relation("ChunkHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  KaiKnowledgeChunk[] @relation("ChunkHierarchy")

  @@index([category], map: "idx_kai_kb_category")
  @@index([subcategory], map: "idx_kai_kb_subcategory")
  @@index([isActive], map: "idx_kai_kb_active")
  @@map("kv_kai_knowledge_chunks")
