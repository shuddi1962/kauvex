}

model KaiFeedback {
  id           String   @id @default(uuid()) @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  rating       Int      // 1-5
  helpful      Boolean?
  feedbackText String?  @map("feedback_text") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  message KaiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "idx_kai_fb_msg")
  @@index([rating], map: "idx_kai_fb_rating")
  @@map("kv_kai_feedback")
}
