// KAUVEX COMMERCE CLOUD (KCC) — Complete Database Schema v2.0
// Generator & Datasource
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

// ============================================================
// EXISTING TABLES (from Supabase migration)
// ============================================================

model Profile {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String?
  fullName        String?   @map("full_name")
  phone           String?
  avatarUrl       String?   @map("avatar_url")
  role            String?  @default("customer")
  vendorId        String?   @map("vendor_id") @db.Uuid
  loyaltyTier     String?   @default("bronze") @map("loyalty_tier")
  loyaltyPoints   Int?      @default(0) @map("loyalty_points")
  walletBalance   Decimal?  @default(0) @map("wallet_balance") @db.Decimal(12, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")

  @@map("profiles")
}

model Category {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String
  slug        String       @unique
  description String?
  icon        String?
  image       String?
  parentId    String?      @map("parent_id") @db.Uuid
  sortOrder   Int?         @default(0) @map("sort_order")
  status      String?      @default("active")
  createdAt   DateTime     @default(now()) @map("created_at")

  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryHierarchy")
  subcategories Subcategory[]
  products    Product[]

  @@map("categories")
}

model Subcategory {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  slug        String
  description String?
  sortOrder   Int?     @default(0) @map("sort_order")

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
  @@map("subcategories")
}

model Brand {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String
  slug        String   @unique
  logo        String?
  description String?
  status      String?  @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  products    Product[]

  @@map("brands")
}

model Product {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String
  slug            String        @unique
  type            String?       @default("simple")
  sku             String?
  shortDescription String?      @map("short_description")
  longDescription String?       @map("long_description")
  categoryId      String?       @map("category_id") @db.Uuid
  brandId         String?       @map("brand_id") @db.Uuid
  regularPrice    Decimal       @map("regular_price") @db.Decimal(12, 2)
  salePrice       Decimal?      @map("sale_price") @db.Decimal(12, 2)
  costPrice       Decimal?      @map("cost_price") @db.Decimal(12, 2)
  vendorId        String?       @map("vendor_id") @db.Uuid
  images          Json?         @default("[]")
  variants        Json?         @default("[]")
  specifications  Json?         @default("{}")
  tags            String[]      @default([])
  rating          Decimal?      @default(0) @db.Decimal(2, 1)
  reviewCount     Int?          @default(0) @map("review_count")
  featured        Boolean?      @default(false)
  status          String?       @default("draft")
  seo             Json?         @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @map("updated_at")

  category        Category?     @relation(fields: [categoryId], references: [id])
  brand           Brand?        @relation(fields: [brandId], references: [id])
  inventory       ProductInventory[]
  reviews         Review[]
  orderItems      OrderItem[]
  cjProduct       CjProduct?

  @@map("products")
}

model ProductInventory {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  locationName      String   @map("location_name")
  quantity          Int?     @default(0)
  lowStockThreshold Int?     @default(5) @map("low_stock_threshold")
  backorderEnabled  Boolean? @default(false) @map("backorder_enabled")

  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_inventory")
}

model Vendor {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String?      @map("user_id") @db.Uuid
  shopName        String       @map("shop_name")
  shopSlug        String       @unique @map("shop_slug")
  shopDescription String?      @map("shop_description")
  shopLogo        String?      @map("shop_logo")
  shopBanner      String?      @map("shop_banner")
  vendorTier      String?      @default("bronze") @map("vendor_tier")
  commission      Decimal?     @default(10) @db.Decimal(5, 2)
  status          String?      @default("pending")
  rating          Decimal?     @default(0) @db.Decimal(2, 1)
  totalSales      Int?         @default(0) @map("total_sales")
  totalRevenue    Decimal?     @default(0) @map("total_revenue") @db.Decimal(12, 2)
  positiveFeedback Decimal?    @default(100) @map("positive_feedback") @db.Decimal(5, 2)
  responseRate    Decimal?     @default(100) @map("response_rate") @db.Decimal(5, 2)
  shipOnTimeRate  Decimal?     @default(100) @map("ship_on_time_rate") @db.Decimal(5, 2)
  joinedAt        DateTime?    @default(now()) @map("joined_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  orders          Order[]
  disputes        Dispute[]

  @@map("vendors")
}

model Order {
  id              String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderNumber     String      @unique @map("order_number")
  customerId      String?     @map("customer_id") @db.Uuid
  subtotal        Decimal     @db.Decimal(12, 2)
  shippingCost    Decimal?    @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  tax             Decimal?    @default(0) @db.Decimal(12, 2)
  discount        Decimal?    @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  status          String?     @default("pending")
  paymentMethod   String?     @map("payment_method")
  paymentStatus   String?     @default("pending") @map("payment_status")
  currency        String?     @default("USD")
  storefrontId    String?     @map("storefront_id") @db.Uuid
  shippingAddress Json?       @map("shipping_address")
  trackingNumber  String?     @map("tracking_number")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @map("updated_at")

  vendor          Vendor?     @relation(fields: [vendorId], references: [id])
  vendorId        String?     @map("vendor_id") @db.Uuid
  storefront      Storefront? @relation(fields: [storefrontId], references: [id])
  items           OrderItem[]
  disputes        Dispute[]

  @@map("orders")
}

model OrderItem {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  productId     String?  @map("product_id") @db.Uuid
  productName   String   @map("product_name")
  productImage  String?  @map("product_image")
  variantInfo   String?  @map("variant_info")
  quantity      Int
  price         Decimal  @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  cjOrderId     String?  @map("cj_order_id")
  cjStatus      String?  @map("cj_status")

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Review {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  rating        Int
  title         String?
  body          String?
  images        String[] @default([])
  isVerified    Boolean? @default(false) @map("is_verified")
  helpfulCount  Int?     @default(0) @map("helpful_count")
  status        String?  @default("approved")
  createdAt     DateTime @default(now()) @map("created_at")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Storefront {
  id              String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String
  slug            String                    @unique
  domainType      String                    @map("domain_type")
  subdomain       String?
  customDomain    String?                   @map("custom_domain")
  activeDomain    String                    @map("active_domain")
  currencyCode    String                    @default("USD") @map("currency_code")
  currencySymbol  String?                   @default("$") @map("currency_symbol")
  languageCode    String?                   @default("en") @map("language_code")
  countryCode     String?                   @map("country_code")
  taxRate         Decimal?                  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxLabel        String?                   @map("tax_label")
  taxInclusive    Boolean?                  @default(false) @map("tax_inclusive")
  isDefault       Boolean?                  @default(false) @map("is_default")
  status          String?                   @default("active")
  metaTitle       String?                   @map("meta_title")
  metaDescription String?                   @map("meta_description")
  catalogMode     Boolean?                  @default(false) @map("catalog_mode")
  ageVerification Boolean?                  @default(false) @map("age_verification")
  minAge          Int?                      @default(18) @map("min_age")
  createdAt       DateTime                  @default(now()) @map("created_at")

  banners         StorefrontBanner[]
  featuredProducts StorefrontFeaturedProduct[]
  vendorMappings  StorefrontVendor[]
  homepageSections HomepageSection[]
  orders          Order[]
  taxRules        TaxRule[]
  shippingRules   ShippingRule[]

  @@map("storefronts")
}

model StorefrontBanner {
  id            String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  storefrontId  String     @map("storefront_id") @db.Uuid
  imageUrl      String     @map("image_url")
  headline      String?
  subtext       String?
  ctaText       String?    @map("cta_text")
  ctaUrl        String?    @map("cta_url")
  sortOrder     Int?       @default(0) @map("sort_order")
  status        String?    @default("active")

  storefront    Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)

  @@map("storefront_banners")
}

model CjProduct {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  cjProductId       String?  @unique @map("cj_product_id")
  cjSku             String?  @map("cj_sku")
  internalProductId String?  @unique @map("internal_product_id") @db.Uuid
  supplierPrice     Decimal? @map("supplier_price") @db.Decimal(10, 2)
  kauvexPrice       Decimal? @map("kauvex_price") @db.Decimal(10, 2)
  markupPercent     Decimal? @map("markup_percent") @db.Decimal(5, 2)
  lastPriceSync     DateTime? @map("last_price_sync")
  lastStockSync     DateTime? @map("last_stock_sync")
  stockStatus       String?  @map("stock_status")
  cjCategory        String?  @map("cj_category")
  shippingMethods   Json?    @map("shipping_methods")
  createdAt         DateTime @default(now()) @map("created_at")

  product           Product? @relation(fields: [internalProductId], references: [id])

  @@map("cj_products")
}

model Dispute {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId         String?         @map("order_id") @db.Uuid
  customerId      String?         @map("customer_id") @db.Uuid
  vendorId        String?         @map("vendor_id") @db.Uuid
  type            String?
  status          String?         @default("open")
  description     String?
  customerEvidence Json?          @map("customer_evidence")
  vendorResponse  String?         @map("vendor_response")
  vendorEvidence  Json?           @map("vendor_evidence")
  adminDecision   String?         @map("admin_decision")
  adminNotes      String?         @map("admin_notes")
  refundAmount    Decimal?        @map("refund_amount") @db.Decimal(10, 2)
  openedAt        DateTime?       @default(now()) @map("opened_at")
  resolvedAt      DateTime?       @map("resolved_at")
  deadline        DateTime?       @map("deadline")

  order           Order?          @relation(fields: [orderId], references: [id])
  vendor          Vendor?         @relation(fields: [vendorId], references: [id])
  messages        DisputeMessage[]

  @@map("disputes")
}

model ExchangeRate {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  baseCurrency  String   @default("USD") @map("base_currency")
  rates         Json
  updatedAt     DateTime @default(now()) @map("updated_at")

  @@map("exchange_rates")
}

model AffiliateLink {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  code          String   @unique
  commissionRate Decimal? @default(5) @map("commission_rate") @db.Decimal(5, 2)
  clicks        Int?     @default(0)
  conversions   Int?     @default(0)
  revenue       Decimal? @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("affiliate_links")
}

// ============================================================
// NEW MODELS — SECTION 1.1: STOREFRONTS (Extended)
// ============================================================

model StorefrontFeaturedProduct {
  storefrontId  String
  productId     String
  sortOrder     Int        @default(0)
  section       String     @default("featured")
  flashSalePrice Decimal?
  flashSaleEnds  DateTime?
  createdAt     DateTime   @default(now())

  storefront    Storefront @relation(fields: [storefrontId], references: [id])

  @@id([storefrontId, productId, section])
  @@map("storefront_featured_products")
}

model StorefrontVendor {
  storefrontId  String
  vendorId      String
  status        String     @default("active")
  createdAt     DateTime   @default(now())

  storefront    Storefront @relation(fields: [storefrontId], references: [id])

  @@id([storefrontId, vendorId])
  @@map("storefront_vendors")
}

model HomepageSection {
  id            String     @id @default(cuid())
  storefrontId  String
  sectionType   String
  title         String?
  sortOrder     Int        @default(0)
  isVisible     Boolean    @default(true)
  config        Json?
  createdAt     DateTime   @default(now())

  storefront    Storefront @relation(fields: [storefrontId], references: [id])

  @@map("homepage_sections")
}

// ============================================================
// SECTION 1.2: VENDOR STORE SYSTEM
// ============================================================

model VendorStore {
  id              String           @id @default(cuid())
  vendorId        String           @unique
  storeName       String
  storeSlug       String           @unique
  storeType       String           @default("marketplace_seller")
  planType        String           @default("free")
  defaultUrl      String
  subdomain       String?
  customDomain    String?
  activeDomain    String?
  sslStatus       String           @default("pending")
  logo            String?
  banner          String?
  description     String?
  tagline         String?
  primaryColor    String?
  accentColor     String?
  themeId         String?
  metaTitle       String?
  metaDescription String?
  rating          Decimal          @default(0) @db.Decimal(3, 2)
  totalReviews    Int              @default(0)
  totalSales      Int              @default(0)
  responseRate    Decimal          @default(0) @db.Decimal(5, 2)
  shipOnTimeRate  Decimal          @default(0) @db.Decimal(5, 2)
  accountHealth   String           @default("good")
  isVerified      Boolean          @default(false)
  isFeatured      Boolean          @default(false)
  status          String           @default("active")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  subscription    StoreSubscription?
  followers       StoreFollower[]
  reviews         StoreReview[]
  themes          StoreTheme[]
  analytics       StoreAnalytics[]
  customPages     StoreCustomPage[]
  fbkEnrollment   FBKEnrollment?

  @@map("vendor_stores")
}

model StoreSubscription {
  id              String                 @id @default(cuid())
  vendorStoreId   String                 @unique
  planType        String
  billingCycle    String                 @default("monthly")
  price           Decimal                @db.Decimal(12, 2)
  currency        String                 @default("USD")
  status          String                 @default("active")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean             @default(false)
  graceUntil      DateTime?
  retryCount      Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  vendorStore     VendorStore            @relation(fields: [vendorStoreId], references: [id])
  payments        StoreSubscriptionPayment[]

  @@map("store_subscriptions")
}

model StoreSubscriptionPayment {
  id              String            @id @default(cuid())
  subscriptionId  String
  amount          Decimal           @db.Decimal(12, 2)
  currency        String
  status          String
  gatewayRef      String?
  paidAt          DateTime?
  createdAt       DateTime          @default(now())

  subscription    StoreSubscription @relation(fields: [subscriptionId], references: [id])

  @@map("store_subscription_payments")
}

model StoreFollower {
  id            String      @id @default(cuid())
  vendorStoreId String
  customerId    String
  createdAt     DateTime    @default(now())

  vendorStore   VendorStore @relation(fields: [vendorStoreId], references: [id])

  @@unique([vendorStoreId, customerId])
  @@map("store_followers")
}

model StoreReview {
  id              String      @id @default(cuid())
  vendorStoreId   String
  customerId      String
  orderId         String?
  overallRating   Int
  productQuality  Int
  deliverySpeed   Int
  customerService Int
  comment         String?
  isVerified      Boolean     @default(false)
  status          String      @default("published")
  createdAt       DateTime    @default(now())

  vendorStore     VendorStore @relation(fields: [vendorStoreId], references: [id])

  @@map("store_reviews")
}

model StoreTheme {
  id            String      @id @default(cuid())
  vendorStoreId String
  themeName     String
  isActive      Boolean     @default(false)
  config        Json?
  createdAt     DateTime    @default(now())

  vendorStore   VendorStore @relation(fields: [vendorStoreId], references: [id])

  @@map("store_themes")
}

model StoreAnalytics {
  id              String      @id @default(cuid())
  vendorStoreId   String
  date            DateTime    @db.Date
  views           Int         @default(0)
  uniqueVisitors  Int         @default(0)
  productViews    Int         @default(0)
  addToCart       Int         @default(0)
  orders          Int         @default(0)
  revenue         Decimal     @default(0) @db.Decimal(12, 2)
  followers       Int         @default(0)
  createdAt       DateTime    @default(now())

  vendorStore     VendorStore @relation(fields: [vendorStoreId], references: [id])

  @@unique([vendorStoreId, date])
  @@map("store_analytics")
}

model StoreCustomPage {
  id              String      @id @default(cuid())
  vendorStoreId   String
  title           String
  slug            String
  content         String      @db.Text
  metaTitle       String?
  metaDescription String?
  status          String      @default("published")
  createdAt       DateTime    @default(now())

  vendorStore     VendorStore @relation(fields: [vendorStoreId], references: [id])

  @@map("store_custom_pages")
}

// ============================================================
// SECTION 1.3: WAREHOUSE & FULFILLMENT
// ============================================================

model Warehouse {
  id              String               @id @default(cuid())
  name            String
  code            String               @unique
  type            String               @default("standard")
  address         String
  city            String
  state           String?
  country         String
  postalCode      String
  latitude        Decimal?             @db.Decimal(10, 7)
  longitude       Decimal?             @db.Decimal(10, 7)
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  status          String               @default("active")
  isPickupPoint   Boolean              @default(false)
  isDropoffZone   Boolean              @default(false)
  operatingHours  Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  inventory       WarehouseInventory[]
  inboundShipments  Shipment[]         @relation("DestinationWarehouse")
  outboundShipments Shipment[]         @relation("OriginWarehouse")
  movements       InventoryMovement[]

  @@map("warehouses")
}

model WarehouseInventory {
  id                String    @id @default(cuid())
  warehouseId       String
  productId         String
  variantId         String?
  sku               String
  quantityOnHand    Int       @default(0)
  quantityReserved  Int       @default(0)
  quantityAvailable Int       @default(0)
  quantityInbound   Int       @default(0)
  reorderPoint      Int       @default(10)
  reorderQty        Int       @default(50)
  binLocation       String?
  lastCountAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, productId, variantId])
  @@map("warehouse_inventory")
}

model InventoryMovement {
  id            String    @id @default(cuid())
  warehouseId   String
  productId     String
  variantId     String?
  sku           String
  movementType  String
  quantity      Int
  referenceType String?
  referenceId   String?
  notes         String?
  performedBy   String?
  createdAt     DateTime  @default(now())

  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("inventory_movements")
}

model Shipment {
  id                  String           @id @default(cuid())
  shipmentNumber      String           @unique
  type                String           @default("inbound")
  status              String           @default("pending")
  originWarehouseId   String?
  destWarehouseId     String?
  orderId             String?
  vendorId            String?
  carrierId           String?
  trackingNumber      String?
  trackingUrl         String?
  labelUrl            String?
  estimatedDelivery   DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  weight              Decimal?         @db.Decimal(10, 2)
  dimensions          Json?
  shippingCost        Decimal?         @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  originWarehouse     Warehouse?       @relation("OriginWarehouse", fields: [originWarehouseId], references: [id])
  destWarehouse       Warehouse?       @relation("DestinationWarehouse", fields: [destWarehouseId], references: [id])
  carrier             ShippingCarrier? @relation(fields: [carrierId], references: [id])
  items               ShipmentItem[]

  @@map("shipments")
}

model ShipmentItem {
  id            String   @id @default(cuid())
  shipmentId    String
  productId     String
  variantId     String?
  sku           String
  quantity      Int
  unitWeight    Decimal? @db.Decimal(10, 2)

  shipment      Shipment @relation(fields: [shipmentId], references: [id])

  @@map("shipment_items")
}

model ShippingCarrier {
  id                    String         @id @default(cuid())
  name                  String
  code                  String         @unique
  type                  String
  apiKey                String?        @db.Text
  apiSecret             String?        @db.Text
  accountNumber         String?
  supportsRealTimeRates Boolean        @default(false)
  supportsTracking      Boolean        @default(true)
  supportsLabels        Boolean        @default(false)
  isActive              Boolean        @default(true)
  config                Json?
  createdAt             DateTime       @default(now())

  shipments             Shipment[]
  rates                 ShippingRate[]

  @@map("shipping_carriers")
}

model ShippingRate {
  id            String         @id @default(cuid())
  carrierId     String
  storefrontId  String?
  name          String
  minWeight     Decimal?       @db.Decimal(10, 2)
  maxWeight     Decimal?       @db.Decimal(10, 2)
  minOrderValue Decimal?       @db.Decimal(12, 2)
  maxOrderValue Decimal?       @db.Decimal(12, 2)
  countries     String[]
  price         Decimal        @db.Decimal(12, 2)
  estimatedDays Int?
  isFree        Boolean        @default(false)
  freeThreshold Decimal?       @db.Decimal(12, 2)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())

  carrier       ShippingCarrier @relation(fields: [carrierId], references: [id])

  @@map("shipping_rates")
}

model ShippingRule {
  id            String     @id @default(cuid())
  storefrontId  String?
  name          String
  carrier       String
  countries     String[]
  minWeight     Decimal?   @db.Decimal(10, 2)
  maxWeight     Decimal?   @db.Decimal(10, 2)
  price         Decimal    @db.Decimal(12, 2)
  freeThreshold Decimal?   @db.Decimal(12, 2)
  estimatedDays Int?
